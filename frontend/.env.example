# Plantilla de variables de entorno del frontend.
#
# Vite lee estos archivos según el modo con que se ejecute:
#   npm run dev                         -> .env.development
#   npm run build                       -> .env.production
#   npm run build -- --mode staging     -> .env.staging
#
# Para un ambiente nuevo, copia este archivo con el nombre del modo
# (por ejemplo .env.production) y cambia los valores.
# Los archivos *.local son personales y no se suben a Git.
#
# IMPORTANTE: todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca pongas aquí contraseñas ni claves secretas.

# Dirección de la API de Python
VITE_API_URL=https://api.mi-tienda.com
