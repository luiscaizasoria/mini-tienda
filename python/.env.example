# Copia este archivo como .env y reemplaza los valores.

# Conexión a PostgreSQL (Supabase)
DATABASE_URL=postgresql+psycopg://usuario:CONTRASENA@host:5432/postgres

# Proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable

# Usuario de prueba, solo para los demos de demos/supabase_auth
TEST_EMAIL=correo@ejemplo.com
TEST_PASSWORD=tu-contrasena

# Orígenes del frontend autorizados por CORS (lista JSON).
# Opcional: por defecto solo se permite http://localhost:5173
# CORS_ORIGINS=["https://mi-tienda.com"]
